{
  "name": "chartbeat-board",
  "productName": "Chartbeat Board",
  "version": "1.0.0",
  "description": "לוח גולשים בזמן אמת מנתוני Chartbeat",
  "type": "module",
  "main": "main.mjs",
  "scripts": {
    "start": "electron .",
    "kiosk": "electron . --fullscreen",
    "serve": "node server.js",
    "demo": "node server.js --demo",
    "probe": "node server.js --probe",
    "test": "node test.js",
    "dist:win": "electron-builder --win portable",
    "dist:mac": "electron-builder --mac dmg"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "local.chartbeat.board",
    "files": ["main.mjs", "server.js", "demo.js", "public/**"],
    "directories": { "output": "dist" }
  },
  "license": "UNLICENSED"
}
